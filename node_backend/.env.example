# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # change to "production" for prod

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRATION=86400000

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password   # Gmail App Password (not your account password)

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── CORS (comma-separated, production origins only) ───────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
